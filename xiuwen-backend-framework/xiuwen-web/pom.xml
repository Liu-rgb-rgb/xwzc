<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiuwen</groupId>
        <artifactId>xiuwen-backend-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>xiuwen-web</artifactId>
    <name>绣纹智创-启动与接口模块</name>

    <dependencies>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-framework</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-pattern</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-product</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-order</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiuwen</groupId>
            <artifactId>xiuwen-course</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
