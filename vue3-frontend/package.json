{
  "name": "xiuwen-vue3-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc -b && vite build && prettier --write \"dist/**/*.{html,js,css}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{json,html,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{json,html,ts,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "prettier": "^3.6.2",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vue-tsc": "^2.0.21"
  }
}
